rules_version = '2';

// Modelo pensado para minimizar lecturas (ver README de datos en friends.service.ts,
// groups.service.ts y fap.service.ts):
// - social/{uid}: un único documento con amigos (y sus totales), solicitudes recibidas y
//   enviadas. La pestaña Amigos cuesta 1 lectura, tenga el usuario los amigos que tenga.
// - groups/{groupId}: incluye los totales de cada miembro en `members`, así abrir un grupo
//   no cuesta lecturas extra.
// - Al sumar/borrar un fap, el propio usuario propaga sus totales a social/{amigo} y a sus
//   grupos (escrituras acotadas por las reglas a su propia entrada).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function socialDoc(uid) {
      return /databases/$(database)/documents/social/$(uid);
    }

    // true si `uid` tiene a quien hace la petición entre sus amigos.
    function hasMeAsFriend(uid) {
      return request.auth.uid in get(socialDoc(uid)).data.get('friends', {});
    }

    // ---------------------------------------------------------------- users
    // Perfil público mínimo, usado solo para la búsqueda por prefijo.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      // Borrar la cuenta elimina también el perfil.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- social
    function mapField(data, field) {
      return data.get(field, {});
    }

    function topKeysOnly(keys) {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(keys);
    }

    // Diferencias en un mapa de primer nivel (friends, requests, sent) respecto al estado previo.
    function mapDiff(field) {
      return mapField(request.resource.data, field).diff(resource == null ? {} : mapField(resource.data, field));
    }

    function onlyMe(diffKeys) {
      return diffKeys == [request.auth.uid].toSet();
    }

    // Otro usuario (request.auth.uid) solo puede tocar su propia entrada en mi documento:
    // 1) enviarme una solicitud,
    function isIncomingRequest() {
      return topKeysOnly(['requests']) &&
        onlyMe(mapDiff('requests').affectedKeys()) &&
        onlyMe(mapDiff('requests').addedKeys()) &&
        !(request.auth.uid in (resource == null ? {} : mapField(resource.data, 'friends')));
    }

    // 2) aceptar la solicitud que yo le envié (sale de `sent` y entra en `friends`),
    function isAcceptOfMySentRequest() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'sent') &&
        topKeysOnly(['sent', 'friends']) &&
        onlyMe(mapDiff('sent').removedKeys()) && onlyMe(mapDiff('sent').affectedKeys()) &&
        onlyMe(mapDiff('friends').addedKeys()) && onlyMe(mapDiff('friends').affectedKeys());
    }

    // 3) rechazar la solicitud que yo le envié,
    function isRejectOfMySentRequest() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'sent') &&
        topKeysOnly(['sent']) &&
        onlyMe(mapDiff('sent').removedKeys()) && onlyMe(mapDiff('sent').affectedKeys());
    }

    // 4) actualizar sus propios totales/perfil en mi lista de amigos. Se admite que no cambie
    //    nada (propagar un valor que ya estaba), para no rechazar escrituras inofensivas.
    function isFriendFanOut() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'friends') &&
        topKeysOnly(['friends']) &&
        mapDiff('friends').affectedKeys().hasOnly([request.auth.uid]) &&
        request.auth.uid in mapField(request.resource.data, 'friends') &&
        request.resource.data.friends[request.auth.uid]
          .diff(resource.data.friends[request.auth.uid]).affectedKeys()
          .hasOnly(['solitario', 'compania', 'total', 'hidden', 'week', 'month', 'prevWeek', 'prevMonth',
                    'streak', 'lastDay', 'badges', 'wins', 'displayName', 'photoURL']);
    }

    // 5) eliminar la amistad: quitarse de mi lista de amigos (al borrar la amistad o su cuenta),
    //    llevándose también su reacción si la había.
    function isUnfriend() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'friends') &&
        topKeysOnly(['friends', 'reactions']) &&
        onlyMe(mapDiff('friends').removedKeys()) && onlyMe(mapDiff('friends').affectedKeys()) &&
        mapDiff('reactions').affectedKeys().hasOnly([request.auth.uid]);
    }

    // 6) retirar la solicitud que me envió.
    function isCancelOfSentRequest() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'requests') &&
        topKeysOnly(['requests']) &&
        onlyMe(mapDiff('requests').removedKeys()) && onlyMe(mapDiff('requests').affectedKeys());
    }

    // 7) mandarme una reacción (se guarda la última de cada amigo), siendo mi amigo.
    function isReaction() {
      return resource != null &&
        request.auth.uid in mapField(resource.data, 'friends') &&
        topKeysOnly(['reactions']) &&
        onlyMe(mapDiff('reactions').affectedKeys()) &&
        request.auth.uid in request.resource.data.reactions &&
        request.resource.data.reactions[request.auth.uid].keys().hasOnly(['emoji', 'at']) &&
        request.resource.data.reactions[request.auth.uid].emoji is string &&
        request.resource.data.reactions[request.auth.uid].emoji.size() <= 8;
    }

    match /social/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) || (isSignedIn() && isIncomingRequest());
      allow update: if isOwner(uid) ||
        (isSignedIn() && (isIncomingRequest() || isAcceptOfMySentRequest() ||
                          isRejectOfMySentRequest() || isFriendFanOut() || isUnfriend() ||
                          isCancelOfSentRequest() || isReaction()));
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- faps
    // Los faps individuales (con fecha) y los totales propios solo los ve su dueño.
    match /faps/{fapId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      // La fecha puede ser pasada (fap olvidado) pero no futura; se admite un pequeño margen por
      // desfase del reloj del dispositivo.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.fecha is timestamp &&
        request.resource.data.fecha <= request.time + duration.value(5, 'm');
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Solo los detalles opcionales: nota, valoración (1-5) y etiquetas.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'valoracion', 'etiquetas']) &&
        (request.resource.data.get('nota', null) == null ||
          (request.resource.data.nota is string && request.resource.data.nota.size() <= 280)) &&
        (request.resource.data.get('valoracion', null) == null ||
          (request.resource.data.valoracion is int && request.resource.data.valoracion >= 1 &&
           request.resource.data.valoracion <= 5)) &&
        (request.resource.data.get('etiquetas', null) == null ||
          (request.resource.data.etiquetas is list && request.resource.data.etiquetas.size() <= 10));
    }

    // Totales, recuentos por día (`days`), hora (`hours`), etiqueta (`tags`) y valoración (`ratings`), objetivos (`goals`); `v` es la
    // versión del formato (fap.model.ts#STATS_VERSION).
    match /fapStats/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['solitario', 'compania', 'updatedAt', 'days', 'hours', 'tags', 'ratings', 'goals', 'v']) &&
        request.resource.data.get('days', {}) is map &&
        request.resource.data.get('hours', {}) is map &&
        request.resource.data.get('solitario', 0) is int && request.resource.data.get('solitario', 0) >= 0 &&
        request.resource.data.get('compania', 0) is int && request.resource.data.get('compania', 0) >= 0;
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- groups
    // Tope de 200 miembros (MAX_GROUP_MEMBERS). `members` debe tener exactamente las mismas
    // claves que `memberUids` (este último existe para la consulta array-contains).
    function isValidGroup(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.memberUids is list && data.memberUids.size() <= 200 &&
        data.memberUids.toSet().size() == data.memberUids.size() &&
        data.ownerUid in data.memberUids &&
        data.members is map && data.members.keys().toSet() == data.memberUids.toSet() &&
        (data.get('imageUrl', null) == null || (data.imageUrl is string && data.imageUrl.size() < 200000));
    }

    // Cada escritura del dueño declara en addedUids los miembros nuevos (máx. 9, por el límite
    // de 10 llamadas get() por petición) y todos deben tenerle como amigo.
    function addedIsFriend(added, i) {
      return added.size() <= i || hasMeAsFriend(added[i]);
    }

    function validAdditions(before, after) {
      return after.addedUids is list && after.addedUids.size() <= 9 &&
        after.addedUids.toSet() == after.memberUids.toSet().difference(before) &&
        addedIsFriend(after.addedUids, 0) && addedIsFriend(after.addedUids, 1) &&
        addedIsFriend(after.addedUids, 2) && addedIsFriend(after.addedUids, 3) &&
        addedIsFriend(after.addedUids, 4) && addedIsFriend(after.addedUids, 5) &&
        addedIsFriend(after.addedUids, 6) && addedIsFriend(after.addedUids, 7) &&
        addedIsFriend(after.addedUids, 8);
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidGroup(request.resource.data) &&
        validAdditions([request.auth.uid].toSet(), request.resource.data);

      // Dueño: añadir/quitar miembros y editar el grupo, sin tocar las entradas de otros
      // miembros que ya estaban (solo puede alterar la suya).
      // Miembro: solo su propia entrada de `members` (propagación de sus totales).
      allow update: if isSignedIn() && (
        (resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         isValidGroup(request.resource.data) &&
         validAdditions(resource.data.memberUids.toSet(), request.resource.data) &&
         request.resource.data.members.diff(resource.data.members).changedKeys().hasOnly([request.auth.uid])) ||
        (request.auth.uid in resource.data.memberUids &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
         request.auth.uid in request.resource.data.members) ||
        // Miembro (no dueño): salir del grupo quitándose de memberUids y de members.
        (request.auth.uid in resource.data.memberUids &&
         request.auth.uid != resource.data.ownerUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members']) &&
         request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
         onlyMe(request.resource.data.members.diff(resource.data.members).removedKeys()) &&
         onlyMe(request.resource.data.members.diff(resource.data.members).affectedKeys()))
      );

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
