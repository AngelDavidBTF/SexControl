rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isFriendOf(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function groupDoc(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    // users/{uid}.groupIds: grupos a los que pertenece el usuario. Se usa en la regla de fapStats
    // para que los miembros de un mismo grupo vean los totales del resto. Como da acceso a datos
    // ajenos, nadie (ni el propio usuario) puede tocarlo libremente: cada escritura cambia un
    // único grupo, indicado en groupChange, y debe cuadrar con groups/{groupId}.memberUids tal
    // como queda tras el batch (groups.service.ts).
    function sharesGroup(uid) {
      return get(userDoc(request.auth.uid)).data.get('groupIds', [])
        .hasAny(get(userDoc(uid)).data.get('groupIds', []));
    }

    function touchesGroupIds() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupIds', 'groupChange']);
    }

    // Solo el dueño del grupo añade miembros, y solo a amigos suyos (o a sí mismo).
    function isGroupAdd(uid, groupId, before, after) {
      return !(groupId in before) &&
        after == before.concat([groupId]) &&
        existsAfter(groupDoc(groupId)) &&
        getAfter(groupDoc(groupId)).data.ownerUid == request.auth.uid &&
        uid in getAfter(groupDoc(groupId)).data.memberUids &&
        (isOwner(uid) || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
    }

    // Quitar el grupo solo si el usuario ya no es miembro (o el grupo se ha borrado),
    // hecho por el dueño del grupo o por el propio usuario.
    function isGroupRemove(uid, groupId, before, after) {
      return groupId in before &&
        after == before.removeAll([groupId]) &&
        (!existsAfter(groupDoc(groupId)) || !(uid in getAfter(groupDoc(groupId)).data.memberUids)) &&
        (isOwner(uid) || get(groupDoc(groupId)).data.ownerUid == request.auth.uid);
    }

    function isValidGroupChange(uid) {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds', 'groupChange']) &&
        request.resource.data.groupChange is string &&
        (isGroupAdd(uid, request.resource.data.groupChange,
                    resource.data.get('groupIds', []), request.resource.data.get('groupIds', [])) ||
         isGroupRemove(uid, request.resource.data.groupChange,
                       resource.data.get('groupIds', []), request.resource.data.get('groupIds', [])));
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['groupIds', 'groupChange']);
      allow update: if (isOwner(uid) && !touchesGroupIds()) || isValidGroupChange(uid);
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isOwner(uid) || isOwner(friendUid);
        // Los documentos espejo los crea en ambos lados quien acepta la solicitud
        // (friends.service.ts#acceptRequest), en un batch que además borra la solicitud.
        // Solo se permite si existe una solicitud pendiente entre ambos: la regla ve el
        // estado previo al batch, así que la solicitud aún existe al evaluarla.
        allow create: if
          (isOwner(uid) && exists(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid))) ||
          (isOwner(friendUid) && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid)));
        allow update: if false;
        allow delete: if isOwner(uid) || isOwner(friendUid);
      }
    }

    // Id determinista {fromUid}_{toUid}: evita duplicados y permite comprobar su existencia
    // desde la regla de friends. Pendiente mientras exista; se borra al aceptar o rechazar.
    match /friendRequests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        !exists(/databases/$(database)/documents/users/$(request.resource.data.toUid)/friends/$(request.auth.uid));
      allow read, delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // Los faps individuales (con fecha) solo los ve su dueño. Amigos y miembros de grupo
    // ven únicamente los totales de fapStats.
    match /faps/{fapId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // fapStats/{uid}: totales por usuario, mantenidos en el mismo batch que crea o borra el fap
    // (fap.service.ts) y recalculados al iniciar sesión. Evita que amigos y grupos tengan que
    // descargar todos los faps de cada persona para contarlos.
    match /fapStats/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid) || sharesGroup(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['solitario', 'compania', 'updatedAt']) &&
        request.resource.data.get('solitario', 0) is int && request.resource.data.get('solitario', 0) >= 0 &&
        request.resource.data.get('compania', 0) is int && request.resource.data.get('compania', 0) >= 0;
      allow delete: if false;
    }

    // Tope de 200 miembros (MAX_GROUP_MEMBERS en group.model.ts). Cada miembro añadido consume
    // una llamada exists() en la regla de users y un batch admite como máximo 20, así que
    // groups.service.ts añade los miembros en tandas.
    function isValidGroup(data) {
      return data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.memberUids is list && request.auth.uid in data.memberUids && data.memberUids.size() <= 200 &&
        (data.get('imageUrl', null) == null || (data.imageUrl is string && data.imageUrl.size() < 200000));
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && isValidGroup(request.resource.data);
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid && isValidGroup(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
