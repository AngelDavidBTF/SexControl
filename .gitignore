# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/.angular
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Capacitor native projects (Fase 5, generados con `npx cap add`)
/android
/ios

# Caché de despliegue de Firebase CLI
/.firebase

# Secretos y salidas de las pruebas
/tests/app-check.local.json
/tests/.out
